{
  "manifest_version": 3,
  "name": "LoL 信号盘 · League Ping Wheel",
  "version": "2.1.0",
  "description": "在任意网页按住 Alt/Ctrl/G + 左键呼出《英雄联盟》风格信号盘：拖动选择方向，松开左键发出信号，右键取消。",
  "minimum_chrome_version": "90",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["lol-ping-wheel.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
